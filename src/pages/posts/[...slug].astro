---
import { type CollectionEntry, render } from "astro:content";
import path from "node:path";
import IconButton from "@components/atoms/action/IconButton.svelte";
import Card from "@components/atoms/display/Card.svelte";
import Markdown from "@components/content/Markdown.astro";
import ImageWrapper from "@components/molecules/ImageWrapper.astro";
import LastUpdatedNotice from "@components/molecules/LastUpdatedNotice.astro";
import License from "@components/molecules/License.astro";
import PostMetadata from "@components/molecules/PostMeta.astro";
import SeriesCard from "@components/molecules/SeriesCard.astro";
import ArticleDiscovery from "@components/organisms/ArticleDiscovery.astro";
import ArticleShare from "@components/organisms/ArticleShare.svelte";
import CommentSection from "@components/organisms/comment/CommentSection.astro";
import EncryptedContent from "@components/organisms/EncryptedContent.astro";
import UmamiStats from "@components/organisms/UmamiStats.astro";
import I18nKey from "@i18n/i18nKey";
import { i18n } from "@i18n/translation";
import Icon from "@iconify/svelte";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { discoverArticles } from "@utils/article-discovery";
import { resolveAsset } from "@utils/asset-utils";
import { getPublishedInstant, getUpdatedInstant } from "@utils/content-date";
import {
	getSeriesCatalog,
	getSortedPosts,
	type PostForList,
} from "@utils/content-utils";
import { formatDateToYYYYMMDD } from "@utils/date-utils";
import { resolveLicenseConfig } from "@utils/license-utils";
import { getMarkdownStylesheetAssets } from "@utils/markdown-assets";
import { getSourceMarkdownSyntaxSnapshot } from "@utils/markdown-source-syntaxes.mjs";
import {
	hasMarkdownSyntax,
	mergeMarkdownSyntaxSnapshots,
} from "@utils/markdown-syntaxes.mjs";
import { initPostIdMap } from "@utils/permalink-utils";
import {
	buildSeriesContexts,
	type SeriesPostContext,
} from "@utils/series-utils";
import {
	getDir,
	getPostUrl,
	getPostUrlBySlug,
	removeFileExtension,
} from "@utils/url-utils";
import katexStylesheet from "katex/dist/katex.css?url";
import overlayScrollbarsStylesheet from "overlayscrollbars/overlayscrollbars.css?url";
import {
	articleConfig,
	commentConfig,
	licenseConfig,
	profileConfig,
	resolveArticleDiscoveryOptions,
	resolveArticleShareOptions,
	resolveCommentOptions,
	resolveLastUpdatedNoticeOptions,
	resolveUmamiOptions,
	seriesConfig,
	siteConfig,
	umamiConfig,
} from "@/config";

export async function getStaticPaths() {
	const blogEntries = await getSortedPosts();
	initPostIdMap(blogEntries);

	// 系列上下文：阅读顺序 + index/total + 组内上一篇/下一篇（仅对有系列的文章）。
	// 功能关闭时不查集合、不构建上下文，文章页不产出任何系列 DOM（零额外负担）。
	const seriesContexts = seriesConfig.enable
		? buildSeriesContexts({
				catalog: await getSeriesCatalog(),
				posts: blogEntries.map((entry) => ({
					slug: entry.id,
					title: entry.data.title,
					published: entry.data.published,
					series: entry.data.series,
					seriesOrder: entry.data.seriesOrder,
				})),
			})
		: new Map<string, SeriesPostContext>();

	const discoveryCandidates = blogEntries.map((entry) => ({
		slug: entry.id,
		data: entry.data,
	}));
	const discoveryOptions = resolveArticleDiscoveryOptions(articleConfig);

	const paths: {
		params: { slug: string };
		props: {
			entry: CollectionEntry<"posts">;
			discovery: { related: PostForList[]; random: PostForList[] };
			series: SeriesPostContext | null;
		};
	}[] = [];

	for (const entry of blogEntries) {
		const defaultSlug = removeFileExtension(entry.id);
		const current = discoveryCandidates.find(
			(candidate) => candidate.slug === entry.id,
		);
		const discovery =
			discoveryOptions && current
				? discoverArticles(
						current,
						discoveryCandidates,
						discoveryOptions.relatedCount,
						discoveryOptions.randomCount,
					)
				: { related: [], random: [] };

		paths.push({
			params: { slug: defaultSlug },
			props: {
				entry,
				discovery,
				series: seriesContexts.get(entry.id) ?? null,
			},
		});

		if (entry.data.alias) {
			let alias = entry.data.alias.replace(/^\/+/, "").replace(/\/+$/, "");
			if (alias.startsWith("posts/")) {
				alias = alias.replace(/^posts\//, "");
			}
			if (alias && alias !== defaultSlug) {
				paths.push({
					params: { slug: alias },
					props: {
						entry,
						discovery,
						series: seriesContexts.get(entry.id) ?? null,
					},
				});
			}
		}
	}

	return paths;
}

const { entry, discovery, series } = Astro.props;
const seriesCardAtTop = seriesConfig.cardPosition !== "bottom";
const isEncrypted = Boolean(
	entry.data.password && entry.data.password.trim().length > 0,
);
// 加密且隐藏首页内容的文章：元信息区已被加密徽标替代，系列卡同样不渲染，
// 避免用系列名/相邻文章标题绕过元信息隐藏；功能关闭时同样不渲染
const seriesCardVisible =
	seriesConfig.enable &&
	series !== null &&
	!(isEncrypted && entry.data.hideHomeContent);
const scope = `post:${entry.id}`;

const { Content, headings, remarkPluginFrontmatter } = await render(entry);
const renderedMarkdownSyntaxes = remarkPluginFrontmatter.markdownSyntaxes;
const sourceMarkdownSyntaxes = hasMarkdownSyntax(
	renderedMarkdownSyntaxes,
	"expressive-code",
)
	? undefined
	: getSourceMarkdownSyntaxSnapshot(entry.body);
const markdownSyntaxes = mergeMarkdownSyntaxSnapshots(
	renderedMarkdownSyntaxes,
	sourceMarkdownSyntaxes,
);
const hasMath = hasMarkdownSyntax(markdownSyntaxes, "math");
const markdownStylesheetAssets =
	await getMarkdownStylesheetAssets(markdownSyntaxes);
const effectiveHeadings = isEncrypted ? [] : headings;
const imageBasePath = entry.filePath
	? path.relative(path.resolve("src"), path.dirname(entry.filePath))
	: path.join("content/posts/", getDir(entry.id));
const effectiveUpdatedDate = entry.data.updated ?? entry.data.published;
const publishedInstant = getPublishedInstant(entry.data);
const updatedInstant = getUpdatedInstant(entry.data);
const postCommentEnabled =
	entry.data.comment !== false && Boolean(resolveCommentOptions(commentConfig));
const lastUpdatedNotice = resolveLastUpdatedNoticeOptions(articleConfig);
const shareOptions = resolveArticleShareOptions(articleConfig);
const postLicense = resolveLicenseConfig(
	licenseConfig,
	entry.data.license,
	profileConfig.name,
);
const umamiEnabled = resolveUmamiOptions(umamiConfig) !== null;
const authorAvatarUrl = shareOptions
	? await resolveAsset(profileConfig.avatar ?? "")
	: "";

const effectiveDescription =
	isEncrypted && entry.data.hideHomeContent
		? i18n(I18nKey.postEncryptedSummary)
		: entry.data.description || entry.data.title;
const ogImage = entry.data.image
	? await resolveAsset(entry.data.image, imageBasePath)
	: undefined;

const canonicalPostUrl = getPostUrl(entry);

const jsonLd = {
	"@context": "https://schema.org",
	"@type": "BlogPosting",
	headline: entry.data.title,
	description: effectiveDescription,
	keywords: entry.data.tags,
	author: {
		"@type": "Person",
		name: profileConfig.name,
		url: Astro.site,
	},
	datePublished: entry.data.publishedAt
		? publishedInstant.toISOString()
		: formatDateToYYYYMMDD(entry.data.published),
	dateModified: entry.data.updatedAt
		? updatedInstant.toISOString()
		: formatDateToYYYYMMDD(effectiveUpdatedDate),
	inLanguage: entry.data.lang
		? entry.data.lang.replace("_", "-")
		: siteConfig.lang.replace("_", "-"),
};

// Smart navigation: series-aware navigation
const seriesPrev = series?.prev
	? {
			url: series.prev.url || getPostUrlBySlug(series.prev.slug),
			title: series.prev.title,
			label: `ЧАСТЬ ${series.index - 1} ИЗ ${series.total}`,
		}
	: null;

const seriesNext = series?.next
	? {
			url: series.next.url || getPostUrlBySlug(series.next.slug),
			title: series.next.title,
			label: `ЧАСТЬ ${series.index + 1} ИЗ ${series.total}`,
		}
	: null;

// Left nav (Older / Series Prev)
const navPrev =
	seriesPrev ||
	(entry.data.nextSlug
		? {
				url: entry.data.nextUrl || getPostUrlBySlug(entry.data.nextSlug),
				title: entry.data.nextTitle,
				label: series ? `ЧАСТЬ ${series.index} ИЗ ${series.total}` : "НАЗАД",
			}
		: null);

// Right nav (Newer / Series Next)
const navNext =
	seriesNext ||
	(entry.data.prevSlug
		? {
				url: entry.data.prevUrl || getPostUrlBySlug(entry.data.prevSlug),
				title: entry.data.prevTitle,
				label: "ДАЛЕЕ",
			}
		: null);
---

<MainGridLayout banner={entry.data.image} ogImage={ogImage} title={entry.data.title} description={effectiveDescription} bannerDate={formatDateToYYYYMMDD(entry.data.published)} lang={entry.data.lang} setOGTypeArticle={true} headings={effectiveHeadings} postCategory={entry.data.category || undefined} page="post" hasComments={postCommentEnabled}>
    {hasMath && <link slot="head" rel="stylesheet" data-swup-optional="math" href={katexStylesheet} />}
    {hasMath && <link slot="head" rel="stylesheet" data-swup-optional="math" href={overlayScrollbarsStylesheet} />}
    {markdownStylesheetAssets.map(({ pack, css }) => <style is:inline slot="head" data-swup-optional={pack} set:html={css}></style>)}
    <script is:inline slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd)}></script>
    <div class="flex w-full rounded-[var(--radius-large)] overflow-hidden relative mb-4">
		<Card color="var(--card-bg)" radius="l" class="post-card z-10 p-0 overflow-hidden relative w-full border border-[color-mix(in_srgb,var(--outline-variant)_18%,transparent)] dark:border-white/[0.05] shadow-[0_4px_20px_-4px_rgba(0,0,0,0.05)] dark:shadow-none">
			{entry.data.image && (
				<ImageWrapper
					id="post-cover"
					src={entry.data.image}
					basePath={imageBasePath}
					class="w-full h-64 sm:h-80 md:h-[23.5rem] object-cover onload-animation"
					loading="eager"
					fetchPriority="high"
					widths={[360, 720, 1080, 1440]}
					sizes="(min-width: 1280px) 1200px, 100vw"
					formats={["avif", "webp"]}
					quality={65}
				/>
			)}
			<div class="px-6 md:px-9 pt-6 pb-6">
			<!-- title -->
			<div class="relative onload-animation">
				<div
					data-pagefind-body data-pagefind-weight="10" data-pagefind-meta="title"
					class="transition w-full block font-bold mb-3
					text-3xl md:text-[2.25rem]/[2.75rem]
					text-[var(--on-surface)]
					flex items-center gap-3"
				>
					<div class="inline-block">
						{entry.data.title}
					</div>
					
				</div>
			</div>

			<!-- metadata -->
			<div class="onload-animation">
				{isEncrypted && entry.data.hideHomeContent ? (
					<div class="flex flex-wrap items-center gap-2 mb-5">
						<div class="flex items-center gap-1.5 px-3 py-1 rounded-full bg-[var(--surface-container-highest)] text-xs font-semibold text-[var(--primary)]">
							<Icon icon="material-symbols:lock-rounded" class="text-sm" />
							<span>{i18n(I18nKey.postEncryptedBadge)}</span>
						</div>
					</div>
				) : (
					<PostMetadata
						class="mb-5"
						published={entry.data.published}
						updated={entry.data.updated}
						tags={entry.data.tags}
						category={entry.data.category}
						wordCount={`${remarkPluginFrontmatter.words} ${i18n(remarkPluginFrontmatter.words === 1 ? I18nKey.wordCount : I18nKey.wordsCount)}`}
						readingTime={`${remarkPluginFrontmatter.minutes} ${i18n(remarkPluginFrontmatter.minutes === 1 ? I18nKey.minuteCount : I18nKey.minutesCount)}`}
					></PostMetadata>
				)}
				{seriesCardVisible && seriesCardAtTop && series && (
					<SeriesCard context={series} class="mb-5 onload-animation" />
				)}
				{!entry.data.image && <div class="border-[var(--outline-variant)] border-dashed border-b-[1px] mb-5"></div>}
			</div>

            <!-- always show cover as long as it has one -->

			

            {isEncrypted ? (
                <EncryptedContent
                    password={entry.data.password!}
                    scope={scope}
                    hint={entry.data.passwordHint}
                >
                    <Content />
                </EncryptedContent>
            ) : (
                <Markdown class="mb-6 onload-animation">
                    <Content />
                </Markdown>
			)}

				{entry.data.tags && entry.data.tags.length > 0 && (
					<div class="flex sm:hidden flex-wrap gap-2 mb-6 onload-animation">
						{entry.data.tags.map((tag: string) => (
							<a
								href={`/archive/?tag=${encodeURIComponent(tag.trim())}`}
								class="inline-flex items-center gap-1 px-3 py-1.5 rounded-[var(--shape-corner-xs)] bg-[var(--surface-container-high)] text-[var(--on-surface-variant)] hover:text-[var(--primary)] text-xs font-medium no-underline transition-colors"
							>
								<span class="opacity-60">#</span>
								<span>{tag.trim()}</span>
							</a>
						))}
					</div>
				)}
			</div>

		<!-- 3. Post Bottom Section with distinct background & subtle edge-to-edge borders -->
		<div class="m3-post-footer border-t border-[color-mix(in_srgb,var(--outline-variant)_18%,transparent)] dark:border-white/[0.05] bg-[color-mix(in_srgb,var(--surface-container)_45%,var(--card-bg))] dark:bg-[var(--surface-container-low)]">
			<!-- Actions Row -->
			<div class="px-6 md:px-9 py-4 flex items-center justify-center md:justify-between gap-4 border-b border-[color-mix(in_srgb,var(--outline-variant)_18%,transparent)] dark:border-white/[0.05]">
				<div class="hidden md:flex items-center gap-2.5">
					<Icon icon="material-symbols:thumb-up-outline-rounded" class="text-lg text-[var(--primary)]" />
					<span class="text-sm font-semibold text-[var(--on-surface)]">Было полезно?</span>
				</div>
				<div class="flex items-center justify-center gap-2.5 w-full md:w-auto">
					<a href="/support/" class="group inline-flex items-center gap-2 h-11 px-4.5 rounded-[var(--shape-corner-m)] bg-[var(--surface-container-high)] hover:bg-[var(--primary)] text-[var(--on-surface)] hover:text-[var(--on-primary)] active:scale-[0.98] transition-all duration-200 no-underline cursor-pointer">
						<Icon icon="material-symbols:savings-rounded" class="text-xl text-[var(--primary)] group-hover:text-[var(--on-primary)] transition-colors duration-200" />
						<span class="text-sm font-semibold transition-colors duration-200">Поддержать</span>
					</a>
					<button id="post-share-trigger" type="button" class="group inline-flex items-center gap-2 h-11 px-4.5 rounded-[var(--shape-corner-m)] bg-[var(--surface-container-high)] text-[var(--on-surface)] hover:text-[var(--primary)] active:scale-[0.98] transition-all duration-200 cursor-pointer border-none">
						<Icon icon="material-symbols:share-outline-rounded" class="text-xl text-[var(--on-surface-variant)] group-hover:text-[var(--primary)] transition-colors duration-200" />
						<span class="text-sm font-semibold transition-colors duration-200">Поделиться</span>
					</button>
				</div>
			</div>

			<!-- Navigation Row (edge-to-edge border with center vertical divider) -->
			<div class="grid grid-cols-1 md:grid-cols-2">
				{navPrev ? (
					<a href={navPrev.url} class="group flex flex-col justify-center px-6 md:px-9 py-5 no-underline transition hover:bg-[var(--surface-container)]">
						<div class="text-[0.75rem] font-bold text-[var(--primary)] tracking-wider mb-1 flex items-center gap-1.5 transition group-hover:translate-x-[-2px]">
							<span>←</span>
							<span>{navPrev.label}</span>
						</div>
						<div class="text-sm font-semibold text-[var(--on-surface)] group-hover:text-[var(--primary)] transition line-clamp-2 leading-snug">
							{navPrev.title}
						</div>
					</a>
				) : (
					<div class="hidden md:block"></div>
				)}

				{navNext ? (
					<a href={navNext.url} class="group flex flex-col justify-center text-right px-6 md:px-9 py-5 no-underline border-t md:border-t-0 md:border-l border-[color-mix(in_srgb,var(--outline-variant)_18%,transparent)] dark:border-white/[0.05] transition hover:bg-[var(--surface-container)]">
						<div class="text-[0.75rem] font-bold text-[var(--primary)] tracking-wider mb-1 flex items-center justify-end gap-1.5 transition group-hover:translate-x-[2px]">
							<span>{navNext.label}</span>
							<span>→</span>
						</div>
						<div class="text-sm font-semibold text-[var(--on-surface)] group-hover:text-[var(--primary)] transition line-clamp-2 leading-snug">
							{navNext.title}
						</div>
					</a>
				) : (
					<div class="hidden md:block border-t md:border-t-0 md:border-l border-[color-mix(in_srgb,var(--outline-variant)_18%,transparent)] dark:border-white/[0.05]"></div>
				)}
			</div>
		</div>

		{shareOptions && (
			<ArticleShare
				client:load
				options={shareOptions}
				title={entry.data.title}
				description={effectiveDescription}
				author={profileConfig.name}
				published={formatDateToYYYYMMDD(entry.data.published)}
				siteTitle={siteConfig.title}
				postPath={canonicalPostUrl}
				coverSelector={entry.data.image ? "#post-cover img" : undefined}
				avatarUrl={authorAvatarUrl}
				triggerOnly={true}
			/>
		)}

		</Card>
    </div>

    <CommentSection
        context={{
            key: `post:${entry.id}`,
            path: canonicalPostUrl,
            title: entry.data.title,
            language: entry.data.lang || siteConfig.lang,
        }}
        postCommentEnabled={entry.data.comment}
        class="onload-animation"
    />

    {lastUpdatedNotice && (
        <LastUpdatedNotice
            date={updatedInstant}
            minimumAgeDays={lastUpdatedNotice.minimumAgeDays}
            class="mb-4 onload-animation"
        />
    )}

    </MainGridLayout>

<style is:global>
/* ???/????? hover ????????????????????
	   reduced-motion ??? motion-reduced ???????????? */
.post-nav .post-nav__arrow {
  transition: transform var(--m3e-duration-medium) var(--m3e-easing-emphasized-decelerate);
}
.post-nav .post-nav__title {
  font: var(--m3e-type-title-medium);
  font-weight: 600;
  color: var(--on-surface-variant);
  transition: color var(--m3e-duration-short) var(--m3e-easing-standard);
}
.post-nav:hover .post-nav__title {
  color: var(--primary);
}
.post-nav--prev:hover .post-nav__arrow {
  transform: translateX(-0.25rem);
}
.post-nav--next:hover .post-nav__arrow {
  transform: translateX(0.25rem);
}
</style>

<script is:inline>
document.addEventListener("DOMContentLoaded", initShareBtn);
document.addEventListener("swup:page:view", initShareBtn);
function initShareBtn() {
    var trigger = document.getElementById("post-share-trigger");
    if (!trigger) return;
    trigger.onclick = function() {
        window.dispatchEvent(new CustomEvent("open-article-share"));
    };
}
</script>
