---
import Chip from "@components/atoms/action/Chip.astro";
/**
 * 标签索引页：全部标签的总览入口。
 * 纯 SSR 直出（无客户端岛）：tonal Chip 云（与侧栏 Tags widget 同一原子语言），
 * 页面级密度放大——每个 chip 附带文章计数徽标；
 * chip 点击进入归档页的对应标签过滤（/archive/?tag=x）。
 */
import Card from "@components/atoms/display/Card.svelte";
import PageHeader from "@components/atoms/display/PageHeader.astro";
import I18nKey from "@i18n/i18nKey";
import { i18n } from "@i18n/translation";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { getTagList } from "@utils/content-utils";
import { getTagUrl } from "@utils/url-utils";

const tags = await getTagList();
const totalPosts = tags.reduce((sum, tag) => sum + tag.count, 0);
const tagSummary = `${tags.length} ${i18n(I18nKey.tagsCount)} · ${totalPosts} ${i18n(I18nKey.postsCount)}`;
---

<MainGridLayout title={i18n(I18nKey.tags)} description={tagSummary} page="tags">
	<Card color="var(--card-bg)" radius="l" class="tag-index px-8 py-6">
		<PageHeader
			icon="material-symbols:tag-rounded"
			title={i18n(I18nKey.tags)}
				subtitle={tagSummary}
		/>
		{tags.length > 0 && (
			<div class="tag-index__grid">
				{tags.map((tag) => (
					<Chip
						href={getTagUrl(tag.name)}
						variant="tonal"
						class="tag-index__chip"
						label={`View all posts with the ${tag.name} tag`}
					>
						<span class="tag-index__name">{tag.name}</span>
						<span class="tag-index__count">{tag.count}</span>
					</Chip>
				))}
			</div>
		)}
		{tags.length === 0 && (
			<div class="tag-index__empty">
				<span>{i18n(I18nKey.noData)}</span>
			</div>
		)}
	</Card>
</MainGridLayout>

<style>
.tag-index {
  display: block;
}
.tag-index__grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(11rem, 1fr));
  gap: 0.625rem;
  margin-top: 1rem;
}
:global(.tag-index .tag-index__chip) {
  display: flex !important;
  align-items: center !important;
  width: 100% !important;
  height: 2.5rem !important;
  box-sizing: border-box !important;
  padding: 0 0.875rem !important;
  font-size: 0.875rem !important;
  font-weight: 600 !important;
  color: var(--on-surface-variant) !important;
  background: var(--surface-container) !important;
  border: 1px solid transparent !important;
  border-radius: var(--shape-corner-m) !important;
  text-decoration: none !important;
  transition: all var(--m3e-duration-short) ease !important;
  overflow: hidden !important;
}
:global(.tag-index .tag-index__chip .m3-chip__content) {
  display: flex !important;
  align-items: center !important;
  justify-content: space-between !important;
  width: 100% !important;
  min-width: 0 !important;
  gap: 0.5rem !important;
}
:global(html.dark .tag-index .tag-index__chip) {
  color: var(--on-surface-variant) !important;
  background: var(--surface-container) !important;
}
:global(.tag-index .tag-index__chip:hover) {
  background: var(--surface-container-high) !important;
  color: var(--on-surface) !important;
  transform: translateY(-1px) !important;
}
:global(.tag-index .tag-index__chip:focus-visible) {
  outline: 2px solid var(--primary) !important;
  outline-offset: 1px !important;
}
.tag-index__name {
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  min-width: 0;
  flex: 1;
  text-align: left;
}
.tag-index__count {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-size: 0.75rem;
  font-weight: 700;
  min-width: 1.5rem;
  height: 1.375rem;
  padding: 0 0.4rem;
  box-sizing: border-box;
  border-radius: var(--shape-corner-s);
  background: color-mix(in srgb, var(--on-surface) 10%, transparent);
  color: var(--on-surface-variant);
  flex-shrink: 0;
  margin-left: 0.5rem;
  transition: all var(--m3e-duration-short) var(--m3e-easing-standard);
}
.tag-index__empty {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 11rem;
  color: var(--on-surface-variant);
  font: var(--m3e-type-body-large);
}
@media (max-width: 639px) {
  .tag-index {
    padding: 1rem 0.75rem;
  }
  .tag-index__grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.5rem;
  }
}
</style>
