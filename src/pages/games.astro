---
/**
 * Игровая коллекция и вишлист Steam:
 * Данные из InfiniteBacklog + Steam (src/data/snapshots/infinitebacklog.json)
 * Отображение через единый медиа-организм MediaSection.
 */
import MediaSection from "@components/organisms/MediaSection.svelte";
import I18nKey from "@i18n/i18nKey";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { resolveI18nText } from "@utils/i18n-utils";
import { getGamesList } from "@utils/media/adapters";
import { gamesConfig } from "@/config/gamesConfig";

if (!gamesConfig.enable) {
	return Astro.redirect("/404/");
}

const pageTitle = resolveI18nText(gamesConfig.title, I18nKey.games);
const pageDescription = resolveI18nText(
	gamesConfig.description,
	I18nKey.gamesBanner,
);

const items = getGamesList();
---

<MainGridLayout
	title={pageTitle}
	description={pageDescription}
	page="games"
>
	<MediaSection
		items={items}
		client:visible
	/>
</MainGridLayout>
