---
/**
 * M3E 博客原子 — TagBadge 文字型小标签。
 * Капсульный стиль для тегов под карточкой поста:
 * - Контрастный фон (btn-regular-bg / surface-container-high)
 * - При ховере акцентный цвет темы с заметным состоянием, не сливающимся с карточкой
 */
interface Props {
	name: string;
	href: string;
	class?: string;
}

const { name, href, class: className } = Astro.props;
---

<a
	class:list={["m3-blog-tagbadge", className]}
	href={href}
	aria-label={`View all posts with the ${name} tag`}
>
	<span class="m3-blog-tagbadge__hash">#</span>
	<span class="m3-blog-tagbadge__text">{name}</span>
</a>

<style>
.m3-blog-tagbadge {
  display: inline-flex;
  align-items: center;
  gap: 0.25rem;
  padding: 0.25rem 0.6rem;
  border-radius: var(--shape-corner-xs, 0.375rem);
  background: var(--surface-container-high);
  color: var(--on-surface-variant);
  text-decoration: none;
  white-space: nowrap;
  font-size: 0.8125rem;
  font-weight: 500;
  border: none;
  transition: all var(--m3e-duration-short) var(--m3e-easing-standard);
}
:global(html.dark) .m3-blog-tagbadge {
  background: rgba(255, 255, 255, 0.05);
  color: var(--on-surface-variant);
}
.m3-blog-tagbadge:hover {
  background: var(--surface-container-highest);
  color: var(--primary);
  transform: translateY(-1px);
}
:global(html.dark) .m3-blog-tagbadge:hover {
  background: rgba(255, 255, 255, 0.1);
  color: var(--primary);
}
.m3-blog-tagbadge:active {
  transform: translateY(0);
}
.m3-blog-tagbadge__hash {
  color: var(--outline);
  opacity: 0.8;
  font-weight: 400;
}
:global(html.dark) .m3-blog-tagbadge__hash {
  color: var(--outline);
  opacity: 0.6;
}
.m3-blog-tagbadge:hover .m3-blog-tagbadge__hash,
:global(html.dark) .m3-blog-tagbadge:hover .m3-blog-tagbadge__hash {
  color: var(--primary);
  opacity: 1;
}
.m3-blog-tagbadge__text {
  transition: color var(--m3e-duration-short) var(--m3e-easing-standard);
}
</style>
