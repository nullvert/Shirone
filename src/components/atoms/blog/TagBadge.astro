---
/**
 * M3E 博客原子 — TagBadge 文字型小标签。
 * `# 名称` 的 tonal 小盒标签（卡片底部标签行用）：24px 高、corner-s 圆角、
 * btn-regular 容器色（跟随明暗），hover 逐级加深、`#` 前缀随文字轻微右移。
 */
interface Props {
	name: string;
	href: string;
	class?: string;
}

const { name, href, class: className } = Astro.props;
---

<a
	class:list={["m3-blog-tagbadge", className]}
	href={href}
	aria-label={`View all posts with the ${name} tag`}
>
	<span class="m3-blog-tagbadge__text">{name}</span>
</a>

<style>
.m3-blog-tagbadge {
  display: inline-flex;
  align-items: center;
  height: 1.625rem;
  padding: 0 0.65rem;
  border-radius: var(--shape-corner-m);
  background: var(--surface-container);
  color: var(--on-surface-variant);
  text-decoration: none;
  white-space: nowrap;
  font-size: 0.75rem;
  font-weight: 600;
  border: 1px solid transparent;
  transition: all var(--m3e-duration-short) var(--m3e-easing-standard);
}
.m3-blog-tagbadge:hover {
  background: var(--surface-container-high);
  color: var(--on-surface);
  transform: translateY(-1px);
}
.m3-blog-tagbadge:active {
  background: var(--surface-container-highest);
}
.m3-blog-tagbadge__text {
  transition: transform var(--m3e-duration-short) var(--m3e-easing-emphasized-decelerate);
}
</style>
