---
/**
 * M3E 博客原子 — TagList 标签网格/列表。
 * 数据驱动：tags 为 { name, href, count? }[]，2 列网格卡片样式（与 MediaFilterGenres 风格对齐）。
 */
import Chip from "@components/atoms/action/Chip.astro";

interface Props {
	tags: { name: string; href: string; count?: number }[];
	class?: string;
}

const { tags = [], class: className } = Astro.props;
---

<div class:list={["m3-blog-taglist", className]}>
	{tags.map((t) => (
		<Chip
			href={t.href}
			variant="tonal"
			class="tag-pill"
			label={`Tag: ${t.name}`}
		>
			<span class="tag-pill__name">{t.name}</span>
			{typeof t.count === "number" && (
				<span class="tag-pill__count">{t.count}</span>
			)}
		</Chip>
	))}
</div>

<style>
.m3-blog-taglist {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 0.5rem;
  width: 100%;
}
:global(.m3-blog-taglist .tag-pill) {
  display: flex !important;
  align-items: center !important;
  width: 100% !important;
  height: 2.25rem !important;
  box-sizing: border-box !important;
  padding: 0 0.75rem !important;
  font-size: 0.8125rem !important;
  font-weight: 600 !important;
  color: var(--on-surface-variant) !important;
  background: var(--surface-container) !important;
  border: 1px solid transparent !important;
  border-radius: var(--shape-corner-m) !important;
  text-decoration: none !important;
  transition: all var(--m3e-duration-short) ease !important;
  overflow: hidden !important;
}
:global(.m3-blog-taglist .tag-pill .m3-chip__content) {
  display: flex !important;
  align-items: center !important;
  justify-content: space-between !important;
  width: 100% !important;
  min-width: 0 !important;
  gap: 0.5rem !important;
}
:global(html.dark .m3-blog-taglist .tag-pill) {
  color: var(--on-surface-variant) !important;
  background: var(--surface-container) !important;
}
:global(.m3-blog-taglist .tag-pill:last-child:nth-child(odd)) {
  grid-column: span 2 !important;
}
:global(.m3-blog-taglist .tag-pill:hover) {
  background: var(--surface-container-high) !important;
  color: var(--on-surface) !important;
  transform: translateY(-1px) !important;
}
:global(.m3-blog-taglist .tag-pill:focus-visible) {
  outline: 2px solid var(--primary) !important;
  outline-offset: 1px !important;
}
.tag-pill__name {
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  min-width: 0;
  flex: 1;
  text-align: left;
}
.tag-pill__count {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-size: 0.6875rem;
  font-weight: 700;
  min-width: 1.3rem;
  height: 1.25rem;
  padding: 0 0.35rem;
  box-sizing: border-box;
  border-radius: var(--shape-corner-s);
  background: color-mix(in srgb, var(--on-surface) 10%, transparent);
  color: var(--on-surface-variant);
  flex-shrink: 0;
  margin-left: 0.5rem;
  transition: all var(--m3e-duration-short) var(--m3e-easing-standard);
}
</style>
