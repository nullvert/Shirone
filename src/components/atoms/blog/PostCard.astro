---
import AccentBar from "@components/atoms/display/AccentBar.svelte";
import I18nKey from "@i18n/i18nKey";
import { i18n } from "@i18n/translation";
/**
 * M3E 博客原子 — PostCard 文章卡片。
 * 数据驱动：标题 / 描述 / 封面 / 元信息（复用 blog/PostMeta）/ 阅读时长。
 * 视觉对齐 display/Card 令牌：surface-container-high 基、corner-large、
 * hover 抬升阴影 + 标题 primary + 箭头滑出；有封面时桌面端右侧 28% 图。
 */
import Icon from "@iconify/svelte";
import type { BlogMetaLink } from "./PostMeta.astro";
import PostMeta from "./PostMeta.astro";
import TagBadge from "./TagBadge.astro";

interface Props {
	href: string;
	title: string;
	description?: string;
	/** 封面图地址（省略则无封面，右侧显示进入箭头按钮） */
	image?: string;
	imageSrcset?: string;
	imageAvifSrcset?: string;
	imageSizes?: string;
	imageWidth?: number;
	imageHeight?: number;
	imageAlt?: string;
	published?: string;
	updated?: string;
	pinned?: boolean;
	encrypted?: boolean;
	category?: BlogMetaLink | null;
	tags?: BlogMetaLink[];
	/** 字数展示文本（如 "1426 words"，渲染在分类右侧） */
	wordCount?: string;
	class?: string;
	style?: string;
}

const {
	href,
	title,
	description,
	image,
	imageSrcset,
	imageAvifSrcset,
	imageSizes,
	imageWidth,
	imageHeight,
	imageAlt = "",
	published,
	updated,
	pinned = false,
	encrypted = false,
	category = null,
	tags = [],
	wordCount,
	class: className,
	style,
} = Astro.props;

const hasCover = !!image;
const pinnedLabel = i18n(I18nKey.pinned);
const encryptedLabel = i18n(I18nKey.postEncryptedBadge);
/* 置顶 + 加密并存时合入可访问名称，避免屏幕阅读器丢失任一状态 */
const stateLabels = [
	pinned ? pinnedLabel : "",
	encrypted ? encryptedLabel : "",
].filter(Boolean);
const titleLabel =
	stateLabels.length > 0 ? `${title}, ${stateLabels.join(", ")}` : title;
---

<article
	class:list={["m3-blog-postcard", { "m3-blog-postcard--cover": hasCover }, className]}
	style={style}
>
	<div class="m3-blog-postcard__body">
		<a
			class="m3-blog-postcard__title"
			href={href}
			aria-label={titleLabel}
		>
			<AccentBar size="medium" />
			{pinned && (
				<span
					class="m3-blog-postcard__pin"
					aria-hidden="true"
					title={pinnedLabel}
				>
					<Icon icon="material-symbols:keep-rounded" />
				</span>
			)}
			{encrypted && (
				<span
					class="m3-blog-postcard__encrypted"
					aria-hidden="true"
					title={encryptedLabel}
				>
					<Icon icon="material-symbols:lock-rounded" />
				</span>
			)}
			<span class="m3-blog-postcard__title-text">{title}</span>
		</a>
		{published && (
			<PostMeta
				class="m3-blog-postcard__meta"
				{published}
				{updated}
				category={category}
				tags={tags}
				{wordCount}
				hideUpdate
				hideTags
			/>
		)}
		{description && <p class="m3-blog-postcard__desc">{description}</p>}
		{tags.length > 0 && (
			<div class="m3-blog-postcard__tags">
				{tags.map((t) => (
					<TagBadge name={t.name} href={t.href} />
				))}
			</div>
		)}
	</div>
	{hasCover ? (
		<a class="m3-blog-postcard__cover" href={href} aria-label={title}>
			<span class="m3-blog-postcard__cover-loading" aria-hidden="true"></span>
			<picture>
				{imageAvifSrcset && <source type="image/avif" srcset={imageAvifSrcset} sizes={imageSizes} />}
				<img
					src={image}
					srcset={imageSrcset}
					sizes={imageSizes}
					width={imageWidth}
					height={imageHeight}
					alt={imageAlt}
					loading="lazy"
					decoding="async"
					onload="this.parentElement?.previousElementSibling?.classList.add('m3-blog-postcard__cover-loading--done')"
					onerror="this.parentElement?.previousElementSibling?.classList.add('m3-blog-postcard__cover-loading--done')"
				/>
			</picture>
			<span class="m3-blog-postcard__cover-mask" aria-hidden="true"></span>
			<span class="m3-blog-postcard__cover-arrow" aria-hidden="true">
				<Icon icon="material-symbols:chevron-right-rounded" />
			</span>
		</a>
	) : (
		<a class="m3-blog-postcard__enter" href={href} aria-label={title}>
			<Icon icon="material-symbols:chevron-right-rounded" />
		</a>
	)}
</article>

<style>
.m3-blog-postcard {
  position: relative;
  display: flex;
/* 移动端封面置顶（DOM：body → cover，column-reverse 反转为 cover 在前） */
  flex-direction: column-reverse;
  box-sizing: border-box;
  width: 100%;
  overflow: hidden;
  border-radius: var(--shape-corner-l);
/* 站点卡片色（浅色 = surface-container-lowest 近白），与侧栏等其它卡片一致 */
  background: var(--card-bg);
  color: var(--on-surface);
/* PostMeta 是 Astro 子组件，需用 global 命中其根节点 */
/* 底部标签行：描述之后的独立一层（TagBadge 文字型小标签） */
/* 封面触摸箭头：卡片 hover 时深色遮罩 + 白色大箭头（与原版封面一致） */
/* 桌面端（≥md）正文变纵向：给右侧让位（断点用 stylus 编译期常量 bp-md，
	   不能写 @media (--m3e-bp-md)：CSS 变量无法作 media 条件，该写法整块失效） */
/* === 移动端：封面置顶布局优化（桌面端保持不动） === */
}
.m3-blog-postcard__body {
  flex: 1;
  min-width: 0;
  padding: 1.5rem 1.5rem 1.25rem;
}
.m3-blog-postcard__title {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  margin: 0;
  font: var(--m3e-type-title-large);
  font-weight: 600;
  line-height: 1.35;
  color: var(--on-surface);
  text-decoration: none;
  border-radius: var(--shape-corner-xs);
  transition: color var(--m3e-duration-short) var(--m3e-easing-standard);
}
.m3-blog-postcard__title:focus-visible {
  outline: 2px solid var(--primary);
  outline-offset: 2px;
}
.m3-blog-postcard:hover .m3-blog-postcard__title {
  color: var(--primary);
}
.m3-blog-postcard__title-text {
  flex: 1;
  min-width: 0;
}
.m3-blog-postcard__pin {
  position: relative;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 1.75rem;
  height: 1.75rem;
  border-radius: var(--shape-corner-m);
  background: var(--primary-container);
  color: var(--on-primary-container);
}
.m3-blog-postcard__pin > :global(svg) {
  width: 1.125rem;
  height: 1.125rem;
}
.m3-blog-postcard__encrypted {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 1.75rem;
  height: 1.75rem;
  border-radius: var(--shape-corner-m);
  background: var(--tertiary-container);
  color: var(--on-tertiary-container);
}
.m3-blog-postcard__encrypted > :global(svg) {
  width: 1.125rem;
  height: 1.125rem;
}
.m3-blog-postcard :global(.m3-blog-postcard__meta) {
  margin-top: var(--m3e-space-4);
}
.m3-blog-postcard__desc {
  margin: var(--m3e-space-3) 0 0;
  font: var(--m3e-type-body-medium);
  color: var(--on-surface-variant);
  line-height: 1.6;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.m3-blog-postcard__tags {
  display: flex;
  flex-wrap: wrap;
  gap: var(--m3e-space-2);
  margin-top: var(--m3e-space-4);
}
.m3-blog-postcard__cover {
  position: relative;
  flex-shrink: 0;
  display: block;
  overflow: hidden;
  text-decoration: none;
}
.m3-blog-postcard__cover > :global(.m3-blog-postcard__cover-loading) {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--surface-container-low);
  transition: opacity var(--m3e-duration-short) var(--m3e-easing-standard);
}
.m3-blog-postcard__cover > :global(.m3-blog-postcard__cover-loading)::after {
  content: "";
  width: 2rem;
  aspect-ratio: 1;
  border-radius: var(--shape-corner-full);
  background: var(--primary-container);
}
.m3-blog-postcard__cover > :global(.m3-blog-postcard__cover-loading--done) {
  opacity: 0;
  pointer-events: none;
}
.m3-blog-postcard__cover > picture,
.m3-blog-postcard__cover > picture > img {
  display: block;
  width: 100%;
  height: 100%;
}
.m3-blog-postcard__cover > picture > img {
  object-fit: cover;
  position: relative;
}
@media (min-width: 768px) {
  .m3-blog-postcard__cover {
    position: absolute;
    top: 0.75rem;
    right: 0.75rem;
    bottom: 0.75rem;
    width: 28%;
    height: auto;
    border-radius: var(--shape-corner-s);
    overflow: hidden;
  }
}
.m3-blog-postcard__cover-mask {
  position: absolute;
  inset: 0;
/* 触摸箭头（原版）：默认隐藏，hover/触摸时深色遮罩 + 白色大箭头 */
  background: transparent;
  transition: background-color var(--m3e-duration-medium) var(--m3e-easing-standard);
/* 移动端不显示（触摸触发的瞬时 hover 也不出现，对齐原版） */
}
@media (max-width: 767px) {
  .m3-blog-postcard__cover-mask {
    display: none;
  }
}
.m3-blog-postcard:hover .m3-blog-postcard__cover-mask {
  background: color-mix(in srgb, #000 30%, transparent);
}
.m3-blog-postcard__cover-arrow {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0;
  transform: scale(0.5);
  transition: opacity var(--m3e-duration-medium) var(--m3e-easing-standard), transform var(--m3e-duration-medium) var(--m3e-easing-emphasized-decelerate);
}
@media (max-width: 767px) {
  .m3-blog-postcard__cover-arrow {
    display: none;
  }
}
.m3-blog-postcard__cover-arrow > :global(svg) {
  width: 3rem;
  height: 3rem;
  color: #fff;
}
.m3-blog-postcard:hover .m3-blog-postcard__cover-arrow {
  opacity: 1;
  transform: scale(1);
}
.m3-blog-postcard__enter {
  position: absolute;
  top: 0.75rem;
  right: 0.75rem;
  bottom: 0.75rem;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 3.25rem;
  border-radius: var(--shape-corner-m);
  background: var(--enter-btn-bg);
  color: var(--primary);
  text-decoration: none;
  transition: background-color var(--m3e-duration-short) var(--m3e-easing-standard);
}
.m3-blog-postcard__enter:focus-visible {
  outline: 2px solid var(--primary);
  outline-offset: 2px;
}
.m3-blog-postcard__enter > :global(svg) {
  width: 2.25rem;
  height: 2.25rem;
}
.m3-blog-postcard:hover .m3-blog-postcard__enter {
  background: var(--enter-btn-bg-hover);
  color: var(--primary);
}
@media (max-width: 767px) {
  .m3-blog-postcard__enter {
    display: none;
  }
}
@media (min-width: 768px) {
  .m3-blog-postcard {
    flex-direction: column;
  }
  .m3-blog-postcard--cover .m3-blog-postcard__body {
    padding-right: calc(28% + 1.5rem);
  }
  .m3-blog-postcard:not(.m3-blog-postcard--cover) .m3-blog-postcard__body {
    padding-right: 4.75rem;
  }
}
@media (max-width: 767px) {
  .m3-blog-postcard .m3-blog-postcard__title :global(.m3-accent-bar) {
    display: none;
  }
  .m3-blog-postcard__cover {
    width: auto;
    aspect-ratio: 2/1;
    margin: 1rem 1rem 0;
    border-radius: var(--shape-corner-m);
  }
  .m3-blog-postcard__cover > picture,
  .m3-blog-postcard__cover > picture > img {
    width: 100%;
    height: 100%;
  }
  .m3-blog-postcard__body {
    padding: 1rem;
  }
}
/* ============================================================
   容器模式联动（PostPage 的命名容器 + #post-list 类钩子）
   同一卡片按所在容器切换 token 形态，而非两套皮肤：
   - m3e-post-list--grid     封面 16:9 通栏贴边（复用移动端封面置顶语言）
   - m3e-post-list--cover-left  list 模式封面居左（桌面 ≥md 镜像布局）
   注意：钩子选择器用单个 &（自身复合），禁止 `& &`（会编译成嵌套后代，
   修饰符形式永不匹配）。
   ============================================================ */
@media (min-width: 768px) {
  @container post-list-layout (min-width: 41rem) {
    :global(.m3e-post-list-shell--compact .m3e-post-list--grid) .m3-blog-postcard {
      flex-direction: column-reverse;
    }
    :global(.m3e-post-list-shell--compact .m3e-post-list--grid) .m3-blog-postcard__cover {
      position: relative;
      inset: auto;
      width: auto;
      height: auto;
      aspect-ratio: 16/9;
      margin: var(--m3e-space-4) var(--m3e-space-4) 0;
      border-radius: var(--shape-corner-m);
    }
    :global(.m3e-post-list-shell--compact .m3e-post-list--grid .m3-blog-postcard) .m3-blog-postcard__body {
      padding: var(--m3e-space-5);
    }
    :global(.m3e-post-list-shell--compact .m3e-post-list--grid .m3-blog-postcard:not(.m3-blog-postcard--cover)) .m3-blog-postcard__body {
      padding-right: 4.75rem;
    }
    :global(.m3e-post-list-shell--compact .m3e-post-list--grid) .m3-blog-postcard :global(.m3-meta-icon) {
      width: 1.5rem;
      height: 1.5rem;
    }
    :global(.m3e-post-list-shell--compact .m3e-post-list--grid) .m3-blog-postcard :global(.m3-meta-icon) > :global(svg) {
      width: 1rem;
      height: 1rem;
    }
  }
  @container post-list-layout (min-width: 49rem) {
    :global(.m3e-post-list-shell--regular .m3e-post-list--grid) .m3-blog-postcard {
      flex-direction: column-reverse;
    }
    :global(.m3e-post-list-shell--regular .m3e-post-list--grid) .m3-blog-postcard__cover {
      position: relative;
      inset: auto;
      width: auto;
      height: auto;
      aspect-ratio: 16/9;
      margin: var(--m3e-space-4) var(--m3e-space-4) 0;
      border-radius: var(--shape-corner-m);
    }
    :global(.m3e-post-list-shell--regular .m3e-post-list--grid .m3-blog-postcard) .m3-blog-postcard__body {
      padding: var(--m3e-space-5);
    }
    :global(.m3e-post-list-shell--regular .m3e-post-list--grid .m3-blog-postcard:not(.m3-blog-postcard--cover)) .m3-blog-postcard__body {
      padding-right: 4.75rem;
    }
    :global(.m3e-post-list-shell--regular .m3e-post-list--grid) .m3-blog-postcard :global(.m3-meta-icon) {
      width: 1.5rem;
      height: 1.5rem;
    }
    :global(.m3e-post-list-shell--regular .m3e-post-list--grid) .m3-blog-postcard :global(.m3-meta-icon) > :global(svg) {
      width: 1rem;
      height: 1rem;
    }
  }
  @container post-list-layout (min-width: 57rem) {
    :global(.m3e-post-list-shell--relaxed .m3e-post-list--grid) .m3-blog-postcard {
      flex-direction: column-reverse;
    }
    :global(.m3e-post-list-shell--relaxed .m3e-post-list--grid) .m3-blog-postcard__cover {
      position: relative;
      inset: auto;
      width: auto;
      height: auto;
      aspect-ratio: 16/9;
      margin: var(--m3e-space-4) var(--m3e-space-4) 0;
      border-radius: var(--shape-corner-m);
    }
    :global(.m3e-post-list-shell--relaxed .m3e-post-list--grid .m3-blog-postcard) .m3-blog-postcard__body {
      padding: var(--m3e-space-5);
    }
    :global(.m3e-post-list-shell--relaxed .m3e-post-list--grid .m3-blog-postcard:not(.m3-blog-postcard--cover)) .m3-blog-postcard__body {
      padding-right: 4.75rem;
    }
    :global(.m3e-post-list-shell--relaxed .m3e-post-list--grid) .m3-blog-postcard :global(.m3-meta-icon) {
      width: 1.5rem;
      height: 1.5rem;
    }
    :global(.m3e-post-list-shell--relaxed .m3e-post-list--grid) .m3-blog-postcard :global(.m3-meta-icon) > :global(svg) {
      width: 1rem;
      height: 1rem;
    }
  }
}
@media (min-width: 768px) {
  :global(.m3e-post-list--cover-left) .m3-blog-postcard__cover {
    right: auto;
    left: 0.75rem;
  }
  :global(.m3e-post-list--cover-left) .m3-blog-postcard--cover .m3-blog-postcard__body {
    padding-right: 1.5rem;
    padding-left: calc(28% + 1.5rem);
  }
}
</style>
