---
import I18nKey from "@i18n/i18nKey";
import { i18n } from "@i18n/translation";
/**
 * M3E 博客原子 — PostCard 文章卡片。
 * 数据驱动：标题 / 描述 / 封面 / 元信息（复用 blog/PostMeta）/ 阅读时长。
 * 视觉对齐 display/Card 令牌：surface-container-high 基、corner-large、
 * hover 抬升阴影 + 标题 primary + 箭头滑出；有封面时桌面端右侧 28% 图。
 */
import Icon from "@iconify/svelte";
import type { BlogMetaLink } from "./PostMeta.astro";
import PostMeta from "./PostMeta.astro";
import TagBadge from "./TagBadge.astro";

interface Props {
	href: string;
	title: string;
	description?: string;
	/** 封面图地址（省略则无封面，右侧显示进入箭头按钮） */
	image?: string;
	imageSrcset?: string;
	imageAvifSrcset?: string;
	imageSizes?: string;
	imageWidth?: number;
	imageHeight?: number;
	imageAlt?: string;
	published?: string;
	updated?: string;
	pinned?: boolean;
	encrypted?: boolean;
	category?: BlogMetaLink | null;
	tags?: BlogMetaLink[];
	/** 字数展示文本（如 "1426 words"，渲染在分类右侧） */
	wordCount?: string;
	class?: string;
	style?: string;
}

const {
	href,
	title,
	description,
	image,
	imageSrcset,
	imageAvifSrcset,
	imageSizes,
	imageWidth,
	imageHeight,
	imageAlt = "",
	published,
	updated,
	pinned = false,
	encrypted = false,
	category = null,
	tags = [],
	wordCount,
	class: className,
	style,
} = Astro.props;

const hasCover = !!image;
const pinnedLabel = i18n(I18nKey.pinned);
const encryptedLabel = i18n(I18nKey.postEncryptedBadge);
/* 置顶 + 加密并存时合入可访问名称，避免屏幕阅读器丢失任一状态 */
const stateLabels = [
	pinned ? pinnedLabel : "",
	encrypted ? encryptedLabel : "",
].filter(Boolean);
const titleLabel =
	stateLabels.length > 0 ? `${title}, ${stateLabels.join(", ")}` : title;
---

<article
	class:list={["m3-blog-postcard", { "m3-blog-postcard--cover": hasCover }, className]}
	style={style}
>
	<div class="m3-blog-postcard__body">
		<a
			class="m3-blog-postcard__title"
			href={href}
			aria-label={titleLabel}
		>
			{pinned && (
				<span
					class="m3-blog-postcard__pin"
					aria-hidden="true"
					title={pinnedLabel}
				>
					<Icon icon="material-symbols:keep-rounded" />
				</span>
			)}
			{encrypted && (
				<span
					class="m3-blog-postcard__encrypted"
					aria-hidden="true"
					title={encryptedLabel}
				>
					<Icon icon="material-symbols:lock-rounded" />
				</span>
			)}
			<span class="m3-blog-postcard__title-text">{title}</span>
		</a>
		{published && (
			<PostMeta
				class="m3-blog-postcard__meta"
				{published}
				{updated}
				category={category}
				tags={tags}
				{wordCount}
				hideUpdate
				hideTags
			/>
		)}
		{description && <p class="m3-blog-postcard__desc">{description}</p>}
		{tags.length > 0 && (
			<div class="m3-blog-postcard__tags">
				{tags.map((t) => (
					<TagBadge name={t.name} href={t.href} />
				))}
			</div>
		)}
	</div>
	{hasCover ? (
		<a class="m3-blog-postcard__cover" href={href} aria-label={title}>
			<span class="m3-blog-postcard__cover-loading" aria-hidden="true"></span>
			<picture>
				{imageAvifSrcset && <source type="image/avif" srcset={imageAvifSrcset} sizes={imageSizes} />}
				<img
					src={image}
					srcset={imageSrcset}
					sizes={imageSizes}
					width={imageWidth}
					height={imageHeight}
					alt={imageAlt}
					loading="lazy"
					decoding="async"
					onload="this.parentElement?.previousElementSibling?.classList.add('m3-blog-postcard__cover-loading--done')"
					onerror="this.parentElement?.previousElementSibling?.classList.add('m3-blog-postcard__cover-loading--done')"
				/>
			</picture>
			<span class="m3-blog-postcard__cover-mask" aria-hidden="true"></span>
			<span class="m3-blog-postcard__cover-arrow" aria-hidden="true">
				<Icon icon="material-symbols:chevron-right-rounded" />
			</span>
		</a>
	) : (
		<a class="m3-blog-postcard__enter" href={href} aria-label={title}>
			<Icon icon="material-symbols:chevron-right-rounded" />
		</a>
	)}
</article>

<style>
.m3-blog-postcard {
  position: relative;
  display: flex;
  flex-direction: column-reverse;
  box-sizing: border-box;
  width: 100%;
  overflow: hidden;
  border-radius: var(--shape-corner-l, 1rem);
  background: var(--card-bg);
  color: var(--on-surface);
  transition: transform var(--m3e-duration-short) var(--m3e-easing-standard),
              box-shadow var(--m3e-duration-short) var(--m3e-easing-standard);
}
.m3-blog-postcard:hover {
  transform: translateY(-2px);
  box-shadow: 0 8px 20px -6px rgba(0, 0, 0, 0.06);
}
:global(html.dark) .m3-blog-postcard:hover {
  box-shadow: 0 8px 24px -6px rgba(0, 0, 0, 0.35);
}
.m3-blog-postcard__body {
  flex: 1;
  min-width: 0;
  padding: 1.25rem 1.25rem 1.5rem;
}
.m3-blog-postcard__title {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  margin: 0;
  font: var(--m3e-type-title-large);
  font-size: 1.25rem;
  font-weight: 700;
  line-height: 1.35;
  color: var(--on-surface);
  text-decoration: none;
  border-radius: var(--shape-corner-xs);
  transition: color var(--m3e-duration-short) var(--m3e-easing-standard);
}
.m3-blog-postcard__title:focus-visible {
  outline: 2px solid var(--primary);
  outline-offset: 2px;
}
.m3-blog-postcard__title:hover {
  color: var(--primary);
}
.m3-blog-postcard__title-text {
  flex: 1;
  min-width: 0;
}
.m3-blog-postcard__pin {
  position: relative;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 1.5rem;
  height: 1.5rem;
  color: var(--primary);
}
.m3-blog-postcard__pin > :global(svg) {
  width: 1.25rem;
  height: 1.25rem;
}
.m3-blog-postcard__encrypted {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 1.5rem;
  height: 1.5rem;
  color: var(--tertiary);
}
.m3-blog-postcard__encrypted > :global(svg) {
  width: 1.25rem;
  height: 1.25rem;
}
.m3-blog-postcard :global(.m3-blog-postcard__meta) {
  margin-top: 0.625rem;
}
.m3-blog-postcard__desc {
  margin: 0.75rem 0 0;
  font: var(--m3e-type-body-medium);
  font-size: 0.875rem;
  color: var(--on-surface-variant);
  line-height: 1.6;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.m3-blog-postcard__tags {
  display: flex;
  flex-wrap: wrap;
  gap: 0.5rem;
  margin-top: 0.875rem;
}
.m3-blog-postcard__cover {
  position: relative;
  flex-shrink: 0;
  display: block;
  width: 100%;
  aspect-ratio: 16 / 9;
  overflow: hidden;
  text-decoration: none;
}
.m3-blog-postcard__cover > :global(.m3-blog-postcard__cover-loading) {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--surface-container-low);
  transition: opacity var(--m3e-duration-short) var(--m3e-easing-standard);
}
.m3-blog-postcard__cover > :global(.m3-blog-postcard__cover-loading)::after {
  content: "";
  width: 2rem;
  aspect-ratio: 1;
  border-radius: var(--shape-corner-full);
  background: var(--primary-container);
}
.m3-blog-postcard__cover > :global(.m3-blog-postcard__cover-loading--done) {
  opacity: 0;
  pointer-events: none;
}
.m3-blog-postcard__cover > picture,
.m3-blog-postcard__cover > picture > img {
  display: block;
  width: 100%;
  height: 100%;
}
.m3-blog-postcard__cover > picture > img {
  object-fit: cover;
  position: relative;
  transition: transform var(--m3e-duration-medium) var(--m3e-easing-standard);
}
.m3-blog-postcard:hover .m3-blog-postcard__cover > picture > img {
  transform: scale(1.03);
}
.m3-blog-postcard__cover-mask {
  position: absolute;
  inset: 0;
  background: transparent;
  transition: background-color var(--m3e-duration-medium) var(--m3e-easing-standard);
}
.m3-blog-postcard:hover .m3-blog-postcard__cover-mask {
  background: color-mix(in srgb, #000 15%, transparent);
}
.m3-blog-postcard__cover-arrow {
  display: none;
}
.m3-blog-postcard__enter {
  display: none;
}

/* ============================================================
   Режимы отображения (Grid vs List) на десктопе (≥ 768px):
   В режиме List обложка крупная, выразительная (36-38%),
   с фиксацией пропорций 16:9 / 16:10.
   ============================================================ */
@media (min-width: 768px) {
  :global(.m3e-post-list--list) .m3-blog-postcard {
    flex-direction: row-reverse;
    align-items: stretch;
    min-height: 12.5rem;
  }
  :global(.m3e-post-list--list) .m3-blog-postcard__body {
    padding: 1.5rem 1.75rem;
  }
  :global(.m3e-post-list--list) .m3-blog-postcard--cover .m3-blog-postcard__body {
    padding-right: 1.5rem;
  }
  :global(.m3e-post-list--list) .m3-blog-postcard__cover {
    position: relative;
    top: auto;
    right: auto;
    bottom: auto;
    left: auto;
    width: 36%;
    min-width: 15rem;
    max-width: 24rem;
    height: auto;
    aspect-ratio: auto;
    margin: 0.875rem;
    border-radius: var(--shape-corner-m, 0.75rem);
    align-self: stretch;
  }
  :global(.m3e-post-list--list.m3e-post-list--cover-left) .m3-blog-postcard {
    flex-direction: row;
  }
  :global(.m3e-post-list--list.m3e-post-list--cover-left) .m3-blog-postcard--cover .m3-blog-postcard__body {
    padding-left: 1.5rem;
    padding-right: 1.75rem;
  }
}
</style>
