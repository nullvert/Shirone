---
import TagBadge from "@components/atoms/blog/TagBadge.astro";
import MetaIcon from "@components/atoms/display/MetaIcon.astro";
import I18nKey from "@i18n/i18nKey";
import { i18n } from "@i18n/translation";

export interface BlogMetaLink {
	name: string;
	href: string;
}

interface Props {
	class?: string;
	published?: string;
	updated?: string;
	category?: BlogMetaLink | null;
	tags?: BlogMetaLink[];
	wordCount?: string;
	readingTime?: string;
	hideTags?: boolean;
	hideUpdate?: boolean;
	uncategorizedLabel?: string;
	noTagsLabel?: string;
}

const {
	class: className,
	published,
	updated,
	category,
	tags = [],
	wordCount,
	readingTime,
	hideTags = false,
	hideUpdate = false,
	uncategorizedLabel = i18n(I18nKey.uncategorized),
} = Astro.props;
---

<div class:list={["m3-blog-postmeta", className]}>
	{published && (
		<span class="m3-blog-postmeta__item">
			<MetaIcon icon="material-symbols:calendar-today-outline-rounded" />
			<span class="m3-blog-postmeta__text">{published}</span>
		</span>
	)}

	{!hideUpdate && updated && updated !== published && (
		<span class="m3-blog-postmeta__item">
			<MetaIcon icon="material-symbols:edit-calendar-outline-rounded" />
			<span class="m3-blog-postmeta__text">{updated}</span>
		</span>
	)}

	{readingTime && (
		<span class="m3-blog-postmeta__item">
			<MetaIcon icon="material-symbols:schedule-outline-rounded" />
			<span class="m3-blog-postmeta__text">{readingTime}</span>
		</span>
	)}

	{wordCount && (
		<span class="m3-blog-postmeta__item hidden sm:inline-flex">
			<MetaIcon icon="material-symbols:article-outline-rounded" />
			<span class="m3-blog-postmeta__text">{wordCount}</span>
		</span>
	)}

	{category && (
		<span class="m3-blog-postmeta__category">
			<a
				class="m3-blog-postmeta__category-btn"
				href={category.href}
				aria-label={`View all posts in the ${category.name} category`}
			>
				<MetaIcon icon="material-symbols:folder-outline-rounded" />
				<span>{category.name}</span>
			</a>
		</span>
	)}

	{!hideTags && tags.length > 0 && (
		<span class="m3-blog-postmeta__tags hidden sm:inline-flex">
			{tags.map((t) => (
				<TagBadge name={t.name} href={t.href} />
			))}
		</span>
	)}
</div>

<style>
.m3-blog-postmeta {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 0.625rem 1rem;
  color: var(--on-surface-variant);
  font-size: 0.875rem;
}
.m3-blog-postmeta__item {
  display: inline-flex;
  align-items: center;
  gap: 0.35rem;
  min-width: 0;
}
.m3-blog-postmeta :global(.m3-meta-icon) {
  width: auto;
  height: auto;
  background: transparent;
  color: inherit;
  border-radius: 0;
  display: inline-flex;
}
.m3-blog-postmeta :global(.m3-meta-icon > svg) {
  width: 1.125rem;
  height: 1.125rem;
}
.m3-blog-postmeta__text {
  font: var(--m3e-type-body-medium);
  font-size: 0.875rem;
  font-weight: 400;
  white-space: nowrap;
}
.m3-blog-postmeta__category-btn {
  display: inline-flex;
  align-items: center;
  gap: 0.35rem;
  padding: 0.25rem 0.6rem;
  border-radius: var(--shape-corner-xs, 0.375rem);
  background: var(--surface-container-high);
  color: var(--on-surface-variant);
  text-decoration: none;
  font-size: 0.8125rem;
  font-weight: 500;
  transition: all var(--m3e-duration-short) var(--m3e-easing-standard);
}
:global(html.dark) .m3-blog-postmeta__category-btn {
  background: rgba(255, 255, 255, 0.05);
  color: var(--on-surface-variant);
}
.m3-blog-postmeta__category-btn:hover {
  background: var(--surface-container-highest);
  color: var(--primary);
}
:global(html.dark) .m3-blog-postmeta__category-btn:hover {
  background: rgba(255, 255, 255, 0.1);
  color: var(--primary);
}
.m3-blog-postmeta__tags {
  display: inline-flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 0.5rem;
}
</style>
