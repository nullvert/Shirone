---
interface Props {
	class: string;
}
const className = Astro.props.class;
---
<div data-pagefind-body class={`prose dark:prose-invert prose-base !max-w-none custom-md markdown-content ${className}`}>
	<slot />
</div>

<style is:global>
.custom-md img {
  border-radius: var(--shape-corner-m);
}
.custom-md hr {
  border: 0;
  border-top: 1px solid var(--line-divider);
}
.custom-md iframe {
  border-radius: var(--shape-corner-m);
  margin-left: auto;
  margin-right: auto;
  max-width: 100%;
}
</style>

<script>
	import { bindMarkdownRuntime } from "@utils/markdown-runtime";

	bindMarkdownRuntime();
</script>
