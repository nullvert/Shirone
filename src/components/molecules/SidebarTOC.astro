---
import TocList from "@components/atoms/blog/TocList.astro";
import type { MarkdownHeading } from "astro";
import { siteConfig } from "@/config/siteConfig";
import WidgetLayout from "./WidgetLayout.astro";

interface Props {
	headings?: MarkdownHeading[];
	class?: string;
	style?: string;
	widget?: unknown;
	isDrawer?: boolean;
}

const {
	headings = [],
	class: className,
	style,
	isDrawer = false,
} = Astro.props;

const removeTailingHash = (text: string) => {
	const lastIndexOfHash = text.lastIndexOf("#");
	if (lastIndexOfHash !== text.length - 1) {
		return text;
	}
	return text.substring(0, lastIndexOfHash);
};

const maxLevel = siteConfig.toc.depth;

const tocHeadings = headings.map((heading) => ({
	depth: heading.depth,
	text: removeTailingHash(heading.text),
	slug: heading.slug,
}));

const tocId = isDrawer ? "drawer-toc" : "toc";
const wrapperId = isDrawer ? "drawer-toc-inner-wrapper" : "toc-inner-wrapper";
---

<WidgetLayout
	id={wrapperId}
	class:list={[isDrawer ? "drawer-toc-widget" : "sidebar-toc", className]}
	{style}
>
	<div id={tocId} class="sidebar-toc__content" data-toc-max-depth={maxLevel}>
		<table-of-contents>
			<TocList headings={tocHeadings} maxDepth={maxLevel} />
		</table-of-contents>
	</div>
</WidgetLayout>

<style lang="stylus">
:global(.sidebar-toc .m3-card)
	background: transparent !important
	box-shadow: none !important
	padding: 0 !important

:global(.sidebar-toc .collapse-wrapper)
	padding: 0 !important

.sidebar-toc__content
	max-height: calc(100dvh - 15rem)
	overflow-y: auto
	overflow-x: hidden
	overscroll-behavior: contain
	padding-block: 0.25rem
	padding-right: 0.25rem
	scroll-padding-block: 0.25rem
	scrollbar-width: thin
	scrollbar-color: transparent transparent
	transition: scrollbar-color var(--m3e-duration-short) var(--m3e-easing-standard)

	&:hover
		scrollbar-color: var(--scrollbar-bg) transparent

	&::-webkit-scrollbar
		width: 4px

	&::-webkit-scrollbar-track
		background: transparent

	&::-webkit-scrollbar-thumb
		background: transparent
		border-radius: var(--shape-corner-full)
		transition: background-color var(--m3e-duration-short) var(--m3e-easing-standard)

	&:hover::-webkit-scrollbar-thumb
		background: var(--scrollbar-bg)

	&:hover::-webkit-scrollbar-thumb:hover
		background: var(--scrollbar-bg-hover)

	&:hover::-webkit-scrollbar-thumb:active
		background: var(--scrollbar-bg-active)

</style>

<script>
class TableOfContents extends HTMLElement {
	tocEl: HTMLElement | null = null;
	visibleClass = "visible";
	observer: IntersectionObserver;
	anchorNavTarget: HTMLElement | null = null;
	headingIdxMap = new Map<string, number>();
	headings: HTMLElement[] = [];
	tocEntries: HTMLAnchorElement[] = [];
	active: boolean[] = [];
	lastActiveIdx = -1;
	anchorNavIdx: number | null = null;
	anchorNavScrollTop = 0;
	updateScheduled = false;

	constructor() {
		super();
		this.observer = new IntersectionObserver(this.markVisibleHeading, {
			rootMargin: "-80px 0px -60% 0px",
			threshold: 0,
		});
	}

	markVisibleHeading = (entries: IntersectionObserverEntry[]) => {
		entries.forEach((entry) => {
			const id = entry.target.id;
			const idx = id ? this.headingIdxMap.get(id) : undefined;
			if (idx !== undefined) {
				this.active[idx] = entry.isIntersecting;
			}
		});

		this.update();
	};

	updateActiveHighlight = () => {
		if (this.headings.length === 0) return;

		// If user clicked an anchor, keep that anchor active until scroll completes or user scrolls
		let best = this.anchorNavIdx;

		if (best === null) {
			const scrollY = window.scrollY;
			const atPageBottom =
				scrollY + window.innerHeight >=
				document.documentElement.scrollHeight - 20;

			if (atPageBottom) {
				best = this.headings.length - 1;
			} else {
				// Offset by top appbar height + buffer (~90px)
				const targetTop = 90;
				// Find the last heading whose top position is <= targetTop
				best = 0;
				for (let j = 0; j < this.headings.length; j++) {
					const el = this.headings[j];
					if (el) {
						const rect = el.getBoundingClientRect();
						if (rect.top <= targetTop) {
							best = j;
						} else {
							break;
						}
					}
				}
			}
		}

		if (best === this.lastActiveIdx) return;
		this.lastActiveIdx = best;

		this.tocEntries.forEach((entry, i) => {
			entry.classList.toggle("m3-blog-toc__item--active", i === best);
		});

		if (this.tocEntries[best]) {
			this.scrollToActiveHeading(this.tocEntries[best], this.anchorNavIdx !== null);
		}
	};

	scrollToActiveHeading = (activeHeading?: HTMLAnchorElement, force = false) => {
		if ((!force && this.anchorNavTarget) || !this.tocEl || !activeHeading)
			return;

		const containerRect = this.tocEl.getBoundingClientRect();
		const itemRect = activeHeading.getBoundingClientRect();
		const edgePadding = 8;
		const visibleTop = containerRect.top + edgePadding;
		const visibleBottom = containerRect.bottom - edgePadding;

		if (itemRect.top >= visibleTop && itemRect.bottom <= visibleBottom) return;

		const delta =
			itemRect.top < visibleTop
				? itemRect.top - visibleTop
				: itemRect.bottom - visibleBottom;
		const maxScrollTop = Math.max(
			0,
			this.tocEl.scrollHeight - this.tocEl.clientHeight,
		);
		const top = Math.max(
			0,
			Math.min(this.tocEl.scrollTop + delta, maxScrollTop),
		);

		this.tocEl.scrollTo({
			top,
			left: 0,
			behavior: "smooth",
		});
	};

	update = () => {
		if (this.updateScheduled) return;
		this.updateScheduled = true;
		requestAnimationFrame(() => {
			this.updateScheduled = false;
			this.updateActiveHighlight();
		});
	};

	releaseAnchorNavigation = () => {
		if (this.anchorNavIdx === null) return;
		this.anchorNavTarget = null;
		this.anchorNavIdx = null;
		this.update();
	};

	handleAnchorClick = (event: Event) => {
		const anchor = event
			.composedPath()
			.find((element) => element instanceof HTMLAnchorElement);

		if (anchor) {
			const id = decodeURIComponent(anchor.hash?.substring(1));
			const idx = this.headingIdxMap.get(id);
			if (idx !== undefined) {
				event.preventDefault();
				event.stopPropagation();
				this.anchorNavTarget = this.headings[idx] ?? null;
				this.anchorNavIdx = idx;
				this.anchorNavScrollTop = Math.max(
					0,
					(this.headings[idx]?.getBoundingClientRect().top ?? 0) +
						window.scrollY -
						80,
				);
				this.updateActiveHighlight();

				history.pushState(history.state, "", anchor.hash);
				window.scrollTo({ top: this.anchorNavScrollTop, behavior: "smooth" });
			} else {
				this.anchorNavTarget = null;
				this.anchorNavIdx = null;
			}
		}
	};

	connectedCallback() {
		const element = document.querySelector(".prose");
		let initialized = false;
		const runInit = () => {
			if (initialized) return;
			initialized = true;
			this.init();
		};

		if (element && getComputedStyle(element).animationName !== "none") {
			element.addEventListener("animationend", runInit, { once: true });
			setTimeout(runInit, 300);
		} else {
			runInit();
		}
	}

	init() {
		this.tocEl =
			this.closest(".sidebar-toc__content") ??
			document.getElementById("toc") ??
			document.getElementById("toc-inner-wrapper");

		if (!this.tocEl) return;

		this.tocEl.addEventListener("click", this.handleAnchorClick, {
			capture: true,
		});

		this.tocEntries = Array.from(
			this.querySelectorAll<HTMLAnchorElement>("a[href^='#']"),
		);

		if (this.tocEntries.length === 0) return;

		this.headings = [];
		this.headingIdxMap.clear();

		for (let i = 0; i < this.tocEntries.length; i++) {
			const hash = this.tocEntries[i]?.hash;
			const id = hash ? decodeURIComponent(hash.substring(1)) : "";
			const heading = id ? document.getElementById(id) : null;
			if (heading instanceof HTMLElement) {
				this.headings.push(heading);
				const idx = this.headings.length - 1;
				this.headingIdxMap.set(id, idx);
				this.observer.observe(heading);
			}
		}
		this.active = new Array(this.headings.length).fill(false);

		window.addEventListener("scroll", this.update, { passive: true });
		window.addEventListener("resize", this.update, { passive: true });
		window.addEventListener("wheel", this.releaseAnchorNavigation, {
			passive: true,
		});
		window.addEventListener("touchstart", this.releaseAnchorNavigation, {
			passive: true,
		});
		window.addEventListener("pointerdown", this.releaseAnchorNavigation, {
			passive: true,
		});
		window.addEventListener("keydown", this.releaseAnchorNavigation);

		this.update();
	}

	disconnectedCallback() {
		this.headings.forEach((heading) => {
			if (heading) this.observer.unobserve(heading);
		});
		this.observer.disconnect();
		window.removeEventListener("scroll", this.update);
		window.removeEventListener("resize", this.update);
		this.tocEl?.removeEventListener("click", this.handleAnchorClick);
		window.removeEventListener("wheel", this.releaseAnchorNavigation);
		window.removeEventListener("touchstart", this.releaseAnchorNavigation);
		window.removeEventListener("pointerdown", this.releaseAnchorNavigation);
		window.removeEventListener("keydown", this.releaseAnchorNavigation);
	}

	/** Re-initialize after the nav content has been rebuilt (e.g. after Swup navigation). */
	reinit() {
		this.disconnectedCallback();
		// Reset state.
		this.tocEl = null;
		this.tocEntries = [];
		this.headings = [];
		this.headingIdxMap.clear();
		this.active = [];
		this.lastActiveIdx = -1;
		this.anchorNavIdx = null;
		this.anchorNavTarget = null;
		this.observer = new IntersectionObserver(this.markVisibleHeading, {
			rootMargin: "-80px 0px -60% 0px",
			threshold: 0,
		});
		this.init();
	}
}

if (!customElements.get("table-of-contents")) {
	customElements.define("table-of-contents", TableOfContents);
}

// ---------------------------------------------------------------------------
// Swup navigation: rebuild the sidebar TOC nav from the new page's headings.
// The sidebar lives outside #swup-container so it is not re-rendered by Swup.
// We mirror the same algorithm used in post-decryption.ts::syncTableOfContents.
// ---------------------------------------------------------------------------
(function bindTocSwupSync() {
	function getMaxDepth(): number {
		const el = document.querySelector<HTMLElement>("[data-toc-max-depth]");
		const parsed = Number.parseInt(el?.dataset.tocMaxDepth ?? "", 10);
		return Number.isFinite(parsed) && parsed > 0 ? parsed : 3;
	}

	function buildTocFromHeadings(
		headings: Array<{ depth: number; text: string; slug: string }>,
		nav: HTMLElement,
	) {
		nav.replaceChildren();
		if (!headings.length) return;
		const base = headings.reduce(
			(m, h) => Math.min(m, h.depth),
			Number.POSITIVE_INFINITY,
		);
		let counter = 0;
		const maxDepth = getMaxDepth();
		for (const h of headings) {
			const rel = h.depth - base;
			if (rel >= maxDepth) continue;
			const top = rel === 0;
			const a = document.createElement("a");
			a.className = `m3-blog-toc__item${top ? "" : " m3-blog-toc__item--sub"}`;
			a.href = `#${encodeURIComponent(h.slug)}`;
			a.title = h.text;
			a.dataset.tocDepth = String(h.depth);
			const mark = document.createElement("span");
			mark.className = "m3-blog-toc__mark";
			mark.setAttribute("aria-hidden", "true");
			if (top) {
				counter += 1;
				mark.textContent = String(counter);
			} else {
				const dot = document.createElement("span");
				dot.className = "m3-blog-toc__dot";
				mark.append(dot);
			}
			const text = document.createElement("span");
			text.className = "m3-blog-toc__text";
			text.textContent = h.text;
			a.append(mark, text);
			nav.append(a);
		}
	}

	function syncTocAfterNavigation() {
		// Collect all sidebar+drawer table-of-contents custom elements.
		const tocs = document.querySelectorAll<HTMLElement & { reinit?: () => void }>("table-of-contents");
		if (!tocs.length) return;

		const container = document.getElementById("swup-container");
		const isPost = container?.dataset.currentPage === "post";

		let headings: Array<{ depth: number; text: string; slug: string }> = [];
		if (isPost) {
			headings = Array.from(
				document.querySelectorAll<HTMLElement>(".prose h1, .prose h2, .prose h3, .prose h4, .prose h5, .prose h6"),
			).flatMap((el) => {
				if (!el.id) return [];
				const raw = (el.textContent ?? "").trim().replace(/#$/, "").trim();
				return [{ depth: Number(el.tagName[1]), text: raw, slug: el.id }];
			});
		}

		tocs.forEach((toc) => {
			const nav = toc.querySelector<HTMLElement>(".m3-blog-toc");
			if (!nav) return;
			buildTocFromHeadings(headings, nav);
			toc.reinit?.();
		});

		// Notify fab-controller so the floating TOC panel also refreshes.
		document.dispatchEvent(new CustomEvent("shirone:toc-synced"));
	}

	document.addEventListener("swup:content:replace", syncTocAfterNavigation);
})();
</script>
