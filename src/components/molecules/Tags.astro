---
import TagList from "@components/atoms/blog/TagList.astro";
import I18nKey from "@i18n/i18nKey";
import { i18n } from "@i18n/translation";
/**
 * 标签侧栏组件（消费 blog/TagList 原子）。
 * 只负责取数转 props：标签名 + 标签 URL。
 * 超过侧栏展示上限（collapseAfter）时，只展示前 N 项，并在卡片底部提供
 * 唯一的「查看全部标签」入口，指向标签索引页（/tags/）。
 */
import Icon from "@iconify/svelte";
import { getTagList } from "@utils/content-utils";
import { getTagUrl, url } from "@utils/url-utils";
import type { TagsWidget } from "@/types/sidebarConfig";
import WidgetLayout from "./WidgetLayout.astro";

const tags = await getTagList();

interface Props {
	class?: string;
	style?: string;
	widget?: TagsWidget;
}
const className = Astro.props.class;
const style = Astro.props.style;

const DISPLAY_LIMIT = Math.max(1, Astro.props.widget?.collapseAfter ?? 20);
const hasOverflow = tags.length > DISPLAY_LIMIT;

const tagItems = tags.slice(0, DISPLAY_LIMIT).map((t) => ({
	name: t.name.trim(),
	href: getTagUrl(t.name),
	count: t.count,
}));
---
<WidgetLayout name={i18n(I18nKey.tags)} id="tags" class={className} style={style}>
	<TagList tags={tagItems} />
	{hasOverflow && (
		<div slot="footer" class="widget-index-link">
			<a href={url("/tags/")} class="media-genres-toggle-link m3-state-layer">
				<span>{i18n(I18nKey.tagsViewAll)}</span>
				<Icon icon="material-symbols:chevron-right-rounded" />
			</a>
		</div>
	)}
</WidgetLayout>

<style>
.widget-index-link {
  padding: 0;
  width: 100%;
}
.media-genres-toggle-link {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 0.35rem;
  width: 100%;
  height: var(--media-filter-item-height, 2.25rem);
  box-sizing: border-box;
  margin-top: 0.65rem;
  margin-bottom: 0.25rem;
  padding: 0 0.75rem;
  font-size: 0.78125rem;
  font-weight: 500;
  color: var(--primary);
  background: color-mix(in srgb, var(--primary) 10%, transparent);
  border: none;
  border-radius: var(--shape-corner-m);
  text-decoration: none;
  cursor: pointer;
  transition: all var(--m3e-duration-short) var(--m3e-easing-standard);
}
.media-genres-toggle-link:focus-visible {
  outline: 2px solid var(--primary);
  outline-offset: 1px;
}
.media-genres-toggle-link > :global(svg) {
  width: 1rem;
  height: 1rem;
  transition: transform var(--m3e-duration-short) var(--m3e-easing-standard);
}
.media-genres-toggle-link:hover {
  background: color-mix(in srgb, var(--primary) 18%, transparent);
}
.media-genres-toggle-link:hover > :global(svg) {
  transform: translateX(0.125rem);
}
</style>
